# Pick ONE provider. Groq is used whenever GROQ_API_KEY is set.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ...or Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Branding
BUSINESS_NAME=Atelier Systems
NEXT_PUBLIC_BRAND_NAME=Atelier Systems

# Optional: Amazon Bedrock knowledge base instead of the /knowledge folder
BAWS_ACCESS_KEY_ID=
BAWS_SECRET_ACCESS_KEY=
BAWS_REGION=us-east-1
